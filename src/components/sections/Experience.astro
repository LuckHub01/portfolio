---
import { getProjects } from '../../utils/data';

const experiences = getProjects('Professionnel');
---

<section id="experience" class="py-20 bg-gray-50 dark:bg-gray-800">
  <div class="container mx-auto px-4 md:px-6">
    <h2 class="text-3xl font-bold text-center mb-4 text-gray-900 dark:text-white">
      Expérience <span class="text-primary-600 dark:text-primary-400">professionnelle</span>
    </h2>
    <p class="text-center text-gray-600 dark:text-gray-300 mb-14 max-w-2xl mx-auto">
      Missions menées en entreprise, du traitement de données à la conception de produits complets.
    </p>

    <div class="max-w-3xl mx-auto">
      <ol class="relative border-l-2 border-accent-200 dark:border-accent-900 pl-8 space-y-10">
        {experiences.map((exp) => (
          <li class="relative">
            <span class="absolute -left-[calc(2rem+5px)] top-1.5 w-3 h-3 rounded-full bg-accent-500 ring-4 ring-gray-50 dark:ring-gray-800"></span>

            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-1">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{exp.title}</h3>
              {exp.period && (
                <span class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">{exp.period}</span>
              )}
            </div>

            <div class="flex flex-wrap items-center gap-2 mb-2 text-sm text-primary-700 dark:text-primary-400 font-medium">
              {exp.organization && <span>{exp.organization.trim()}</span>}
              {exp.role && (
                <>
                  <span class="text-gray-300 dark:text-gray-600">·</span>
                  <span class="text-gray-600 dark:text-gray-300 font-normal">{exp.role}</span>
                </>
              )}
            </div>

            <p class="text-gray-700 dark:text-gray-300">{exp.description}</p>

            {exp.achievement && (
              <p class="mt-2 text-sm font-medium text-accent-600 dark:text-accent-400">
                <i class="fas fa-award mr-1"></i>{exp.achievement}
              </p>
            )}

            {exp.technologies && (
              <div class="flex flex-wrap gap-2 mt-3">
                {exp.technologies.map((tech) => (
                  <span class="px-2 py-0.5 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 rounded text-xs">
                    {tech}
                  </span>
                ))}
              </div>
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>